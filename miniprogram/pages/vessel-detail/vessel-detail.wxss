.page { min-height: 100vh; }
.with-action { padding-bottom: 150rpx; }
.loading { padding: 120rpx 0; color: #747b77; text-align: center; }
.hero { position: relative; overflow: hidden; width: 100%; background: #dbe6de; }.hero-image { display: block; width: 100%; }.hero-copy { position: absolute; right: 30rpx; bottom: 38rpx; left: 30rpx; color: #fff; text-shadow: 0 3rpx 14rpx rgba(0,0,0,.28); }.hero-official { font-size: 22rpx; letter-spacing: 1.2rpx; opacity: .82; }.hero-name { margin-top: 8rpx; font-size: 48rpx; font-weight: 700; }
.hero { overflow: visible; }.hero-copy { position: relative; right: auto; bottom: auto; left: auto; z-index: 1; margin-top: -172rpx; padding: 32rpx 30rpx 52rpx; text-shadow: none; }.hero-intro { margin-top: 26rpx; color: rgba(255,255,255,.9); font-size: 26rpx; line-height: 1.8; white-space: pre-line; }
.vessel-intro-card { color: #fff; box-shadow: 0 14rpx 36rpx rgba(20,63,53,.12); }.vessel-intro-card .section-title { color: #fff; }.vessel-intro-copy { color: rgba(255,255,255,.9); font-size: 26rpx; line-height: 1.8; white-space: pre-line; }
.section { margin: 24rpx; padding: 32rpx; border-radius: 28rpx; background: #fff; }
.title { margin-top: 14rpx; color: #143f35; font-family: serif; font-size: 46rpx; font-weight: 700; }
.official-name { margin-top: 6rpx; color: #728078; font-size: 21rpx; letter-spacing: 1rpx; }
.summary, .cabin-copy, .route-copy { margin-top: 14rpx; color: #565e5a; font-size: 26rpx; line-height: 1.7; }
.facility-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28rpx 18rpx; padding: 42rpx 30rpx 26rpx; background: #fff; }
.facility-item { display: flex; align-items: center; min-width: 0; gap: 14rpx; font-size: 24rpx; line-height: 1.45; }
.facility-icon { flex: 0 0 auto; width: 36rpx; height: 36rpx; -webkit-mask-repeat: no-repeat; -webkit-mask-position: center; -webkit-mask-size: contain; mask-repeat: no-repeat; mask-position: center; mask-size: contain; }
.facility-text { min-width: 0; }
.facility-icon-verified-badge { -webkit-mask-image: url("../../assets/verified-badge.svg"); mask-image: url("../../assets/verified-badge.svg"); }
.facility-icon-capacity { -webkit-mask-image: url("../../assets/capacity.svg"); mask-image: url("../../assets/capacity.svg"); }
.facility-icon-science-center { -webkit-mask-image: url("../../assets/science_center.svg"); mask-image: url("../../assets/science_center.svg"); }
.facility-icon-wifi { -webkit-mask-image: url("../../assets/wifi.svg"); mask-image: url("../../assets/wifi.svg"); }
.facility-icon-hybrid { -webkit-mask-image: url("../../assets/hybrid.svg"); mask-image: url("../../assets/hybrid.svg"); }
.facility-icon-modern-stable-tech { -webkit-mask-image: url("../../assets/modern_stable_tech.svg"); mask-image: url("../../assets/modern_stable_tech.svg"); }
.facility-icon-restaurants { -webkit-mask-image: url("../../assets/restaurants.svg"); mask-image: url("../../assets/restaurants.svg"); }
.facility-icon-bars { -webkit-mask-image: url("../../assets/bars.svg"); mask-image: url("../../assets/bars.svg"); }
.facility-icon-lounge { -webkit-mask-image: url("../../assets/lounge.svg"); mask-image: url("../../assets/lounge.svg"); }
.facility-icon-spa { -webkit-mask-image: url("../../assets/spa.svg"); mask-image: url("../../assets/spa.svg"); }
.facility-icon-swimming-pool { -webkit-mask-image: url("../../assets/swimming_pool.svg"); mask-image: url("../../assets/swimming_pool.svg"); }
.facility-icon-hot-tubs { -webkit-mask-image: url("../../assets/hot_tubs.svg"); mask-image: url("../../assets/hot_tubs.svg"); }
.facility-icon-fitness { -webkit-mask-image: url("../../assets/fitness.svg"); mask-image: url("../../assets/fitness.svg"); }
.section-title { margin-bottom: 20rpx; color: #151515; font-size: 32rpx; font-weight: 650; }
.body-copy { color: #565e5a; font-size: 26rpx; line-height: 1.8; white-space: pre-line; }
.gallery-scroll { display: flex; gap: 18rpx; overflow-x: scroll; padding: 0 24rpx 24rpx; white-space: nowrap; }
.gallery-image { width: 470rpx; height: 300rpx; border-radius: 22rpx; background: #dbe6de; }
.experience { padding: 26rpx 0; border-bottom: 1rpx solid #eceeeb; }
.experience:first-of-type { padding-top: 0; }
.experience:last-child { border-bottom: 0; padding-bottom: 0; }
.experience-title, .group-title { color: #143f35; font-size: 29rpx; font-weight: 650; }
.experience-image, .cabin-image { width: 100%; height: 300rpx; margin-top: 20rpx; border-radius: 18rpx; background: #dbe6de; }
.cabin-group + .cabin-group { margin-top: 36rpx; }
.group-title { margin-bottom: 2rpx; }
.cabin { padding: 24rpx 0; border-bottom: 1rpx solid #eceeeb; }
.cabin-name { color: #143f35; font-size: 29rpx; font-weight: 650; }
.cabin-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.cabin-code { flex: 0 0 auto; padding: 5rpx 10rpx; border: 1rpx solid #b6c8be; border-radius: 8rpx; color: #426055; font-size: 19rpx; }
.cabin-facts { display: flex; flex-wrap: wrap; gap: 8rpx 18rpx; margin-top: 14rpx; color: #66746d; font-size: 22rpx; }
.cabin-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.cabin-tags text { padding: 8rpx 13rpx; border-radius: 999rpx; background: #edf2ef; color: #426055; font-size: 20rpx; }
.cabin-note { margin-top: 22rpx; color: #7c827e; font-size: 21rpx; line-height: 1.6; }
.route-card { overflow: hidden; margin-top: 20rpx; border: 1rpx solid #edf0ed; border-radius: 20rpx; }
.route-image { width: 100%; height: 230rpx; background: #dbe6de; }
.route-body { padding: 24rpx; }
.route-kicker { color: #718079; font-size: 20rpx; }
.route-title { margin-top: 8rpx; color: #143f35; font-size: 30rpx; font-weight: 650; }
.route-copy { display: -webkit-box; overflow: hidden; margin-top: 8rpx; font-size: 23rpx; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.action-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 5; padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.96); }
.consult-button { border-radius: 999rpx; background: #143f35; color: #fff; font-size: 29rpx; font-weight: 600; }
.consult-button::after { border: 0; }
