<view class="page with-action">
  <page-nav title="{{vessel.name}}" transparent="{{true}}" show-title="{{navCollapsed}}" show-back="{{true}}" collapsed="{{navCollapsed}}" background-color="{{vessel.card_tone || '#143f35'}}" />
  <view wx:if="{{loading}}" class="loading">正在展开船只档案…</view>
  <empty-state wx:elif="{{error}}" title="暂时无法查看船只" description="{{error}}" bind:retry="loadVessel" />
  <block wx:else>
    <view wx:if="{{vessel.card_image}}" class="hero" style="background-color: {{vessel.card_tone || '#143f35'}}">
      <image class="hero-image" src="{{vessel.card_image}}" mode="widthFix" />
      <view class="hero-copy">
        <view class="hero-official">{{vessel.official_name}}</view>
        <view class="hero-name">{{vessel.name}}</view>
        <view wx:if="{{vessel.intro_zh}}" class="hero-intro">{{vessel.intro_zh}}</view>
      </view>
    </view>
    <view wx:if="{{detail.facilities.length}}" class="facility-grid">
      <view wx:for="{{detail.facilities}}" wx:key="text" class="facility-item" style="color: {{vessel.card_tone || '#143f35'}}">
        <image class="facility-icon" src="{{apiBaseUrl}}/vessel-icons/{{item.icon}}.svg?tone={{detail.iconTone}}" mode="aspectFit" />
        <text class="facility-text">{{item.text}}</text>
      </view>
    </view>

    <view wx:if="{{detail.pageBlocks.length}}" class="page-composer">
      <block wx:for="{{detail.pageBlocks}}" wx:key="index">
        <view wx:if="{{item.block_type === 'heading'}}" class="composer-heading" style="{{detail.cardToneStyle}}">{{item.title}}</view>
        <view wx:else class="composer-card">
          <swiper wx:if="{{item.images.length > 1}}" class="composer-card-swiper" indicator-dots="{{true}}" indicator-color="rgba(255,255,255,.25)" indicator-active-color="#ffffff">
            <swiper-item wx:for="{{item.images}}" wx:for-item="image" wx:key="*this">
              <image class="composer-card-image" src="{{image}}" mode="aspectFill" />
            </swiper-item>
          </swiper>
          <image wx:else class="composer-card-image" src="{{item.images[0]}}" mode="aspectFill" />
          <view class="composer-card-title" style="{{detail.cardToneStyle}}">{{item.title}}</view>
          <view wx:if="{{item.body}}" class="composer-card-body">{{item.body}}</view>
        </view>
      </block>
    </view>

    <view wx:if="{{detail.showCabins && detail.cabinGroups.length}}" class="section">
      <view class="section-title">舱位选择</view>
      <view wx:for="{{detail.cabinGroups}}" wx:for-item="cabinGroup" wx:key="slug" class="cabin-group">
        <view class="group-title" style="{{detail.cardToneStyle}}">{{cabinGroup.title}}</view>
        <view wx:for="{{cabinGroup.cabins}}" wx:for-item="cabin" wx:key="id" class="cabin">
          <image wx:if="{{cabin.media.length}}" class="cabin-image" src="{{cabin.media[0].image}}" mode="aspectFill" />
          <view class="cabin-header">
            <view class="cabin-name">{{cabin.name}}</view>
            <text wx:if="{{cabin.official_code}}" class="cabin-code">{{cabin.official_code}}</text>
          </view>
          <view wx:if="{{cabin.description_zh || cabin.summary}}" class="cabin-copy">{{cabin.description_zh || cabin.summary}}</view>
          <view class="cabin-facts">
            <text wx:if="{{cabin.size_sqm}}">{{cabin.size_sqm}}㎡</text>
            <text wx:if="{{cabin.max_guests}}">最多 {{cabin.max_guests}} 人</text>
            <text wx:if="{{cabin.deck}}">{{cabin.deck}}</text>
          </view>
          <view wx:if="{{cabin.amenities.length || cabin.highlights.length}}" class="cabin-tags">
            <text wx:for="{{cabin.amenities.length ? cabin.amenities : cabin.highlights}}" wx:key="*this">{{item}}</text>
          </view>
        </view>
      </view>
      <view class="cabin-note">具体舱号、床型、视野与可售状态，以所选团期的正式确认信息为准。</view>
    </view>

    <view wx:if="{{detail.deckPlans.length}}" class="section">
      <view class="section-title">甲板示意图</view>
      <view wx:for="{{detail.deckPlans}}" wx:key="image" class="deck-plan">
        <image class="deck-plan-image" src="{{item.image}}" mode="widthFix" />
        <view wx:if="{{item.title}}" class="deck-plan-title">{{item.title}}</view>
        <view wx:if="{{item.description}}" class="deck-plan-copy">{{item.description}}</view>
      </view>
    </view>

    <view wx:if="{{detail.products.length}}" class="section">
      <view class="section-title">这艘船可选择的路线</view>
      <view wx:for="{{detail.products}}" wx:key="slug" class="route-card" bindtap="openProduct" data-slug="{{item.slug}}">
        <image wx:if="{{item.hero_image}}" class="route-image" src="{{item.hero_image}}" mode="aspectFill" />
        <view class="route-body">
          <view class="route-kicker">{{item.season}}</view>
          <view class="route-title">{{item.title}}</view>
          <view class="route-copy">{{item.subtitle || item.summary}}</view>
        </view>
      </view>
    </view>

    <view class="action-bar"><button class="consult-button" bindtap="consult">咨询这艘船</button></view>
  </block>
</view>
