.home-page { padding: 38px 32rpx 64rpx; }
.eyebrow { color: #64706b; font-size: 21rpx; letter-spacing: 3rpx; }
.headline { margin-top: 18rpx; color: #143f35; font-family: serif; font-size: 58rpx; font-weight: 700; }
.lead { margin: 18rpx 0 42rpx; color: #5f6662; font-size: 28rpx; line-height: 1.7; }
.loading-card { padding: 72rpx 32rpx; border-radius: 28rpx; background: #fff; color: #747976; text-align: center; }
.product-card { overflow: hidden; margin-bottom: 28rpx; border-radius: 30rpx; background: #fff; box-shadow: 0 14rpx 36rpx rgba(20,63,53,.08); }
.product-image { display: block; width: 100%; height: 380rpx; background: #dbe6de; }
.product-body { padding: 30rpx; }
.product-kicker { color: #76807b; font-size: 22rpx; }
.product-title { margin-top: 12rpx; color: #151515; font-size: 36rpx; font-weight: 650; }
.product-summary { margin-top: 12rpx; color: #656b68; font-size: 26rpx; line-height: 1.6; }
.vessel-section { margin: 12rpx -32rpx 42rpx; }.section-heading { display: flex; justify-content: space-between; align-items: baseline; padding: 0 32rpx 22rpx; color: #151515; font-size: 32rpx; font-weight: 650; }.section-note { color: #79817d; font-size: 21rpx; font-weight: 400; }.vessel-scroll { width: 100%; white-space: nowrap; }.vessel-row { display: flex; gap: 20rpx; padding: 0 32rpx; }.vessel-card { flex: 0 0 540rpx; overflow: hidden; white-space: normal; border-radius: 26rpx; background: #143f35; box-shadow: 0 14rpx 30rpx rgba(20,63,53,.14); }.vessel-image { display: block; width: 100%; height: 260rpx; }.vessel-card-body { padding: 28rpx; }.vessel-name { color: #fff; font-family: serif; font-size: 38rpx; font-weight: 700; }.vessel-official { margin-top: 6rpx; color: rgba(255,255,255,.64); font-size: 20rpx; letter-spacing: 1rpx; }.vessel-fact { display: flex; gap: 18rpx; margin-top: 20rpx; color: #d5e0d9; font-size: 21rpx; }.vessel-summary { display: -webkit-box; overflow: hidden; margin-top: 18rpx; color: rgba(255,255,255,.82); font-size: 23rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
.all-products { padding: 20rpx 0 42rpx; color: #143f35; font-size: 27rpx; font-weight: 600; text-align: center; }.future-title { margin-bottom: 22rpx; color: #151515; font-size: 32rpx; font-weight: 650; }.future-list { display: flex; flex-direction: column; gap: 18rpx; }
