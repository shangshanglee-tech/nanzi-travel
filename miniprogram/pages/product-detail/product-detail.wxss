.page { min-height: 100vh; }.with-action { padding-bottom: 150rpx; }.loading { padding: 120rpx 0; color: #747b77; text-align: center; }.hero { width: 100%; height: 500rpx; background: #dbe6de; }.intro, .section { margin: 24rpx; padding: 32rpx; border-radius: 28rpx; background: #fff; }.kicker { color: #74807a; font-size: 22rpx; }.title { margin-top: 14rpx; color: #143f35; font-family: serif; font-size: 46rpx; font-weight: 700; }.summary, .day-copy, .bullet { margin-top: 14rpx; color: #565e5a; font-size: 26rpx; line-height: 1.7; }.fact-row { display: flex; flex-wrap: wrap; gap: 16rpx 28rpx; margin-top: 24rpx; color: #143f35; font-size: 24rpx; }.section-title { margin-bottom: 20rpx; color: #151515; font-size: 32rpx; font-weight: 650; }.section-lead { margin: -6rpx 0 14rpx; color: #767d79; font-size: 22rpx; line-height: 1.6; }.vessel-list { display: flex; flex-direction: column; gap: 16rpx; }.vessel-card, .selected-ship { display: flex; gap: 20rpx; padding: 22rpx; border-radius: 18rpx; background: #edf2ef; }.vessel-image { width: 140rpx; height: 140rpx; flex: 0 0 140rpx; border-radius: 14rpx; background: #dbe6de; }.vessel-name, .selected-ship-name { color: #143f35; font-size: 28rpx; font-weight: 650; }.vessel-copy, .selected-ship-copy { display: -webkit-box; overflow: hidden; margin-top: 8rpx; color: #59655f; font-size: 22rpx; line-height: 1.55; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }.vessel-fact { display: flex; gap: 16rpx; margin-top: 10rpx; color: #638071; font-size: 20rpx; }.departure { display: flex; justify-content: space-between; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #eceeeb; color: #565e5a; font-size: 25rpx; }.departure-selected { margin: 0 -14rpx; padding: 22rpx 14rpx; border-radius: 16rpx; border-bottom: 0; background: #eaf2ed; }.departure-date { color: #263a31; font-size: 26rpx; font-weight: 600; }.departure-vessel { margin-top: 7rpx; color: #728078; font-size: 21rpx; }.departure-arrow { color: #416a58; font-size: 21rpx; }.selected-ship { margin-top: 20rpx; background: #143f35; }.selected-ship-label { color: #b9cdc2; font-size: 20rpx; }.selected-ship-name { margin-top: 6rpx; color: #fff; }.selected-ship-copy { color: rgba(255,255,255,.78); }.day { padding: 22rpx 0; border-bottom: 1rpx solid #eceeeb; }.day-index { color: #829087; font-size: 20rpx; letter-spacing: 2rpx; }.day-index text { letter-spacing: 0; }.day-title { margin-top: 8rpx; color: #143f35; font-size: 29rpx; font-weight: 600; }.gallery { white-space: nowrap; }.gallery-image { width: 500rpx; height: 320rpx; margin-right: 18rpx; border-radius: 20rpx; }.notice { background: #e7ece8; }.action-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 5; padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.96); }.consult-button { border-radius: 999rpx; background: #143f35; color: #fff; font-size: 29rpx; font-weight: 600; }.consult-button::after { border: 0; }
