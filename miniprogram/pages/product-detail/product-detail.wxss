.page { min-height: 100vh; }.with-action { padding-bottom: 150rpx; }.loading { padding: 120rpx 0; color: #747b77; text-align: center; }.hero { width: 100%; height: 500rpx; background: #dbe6de; }.intro, .section { margin: 24rpx; padding: 32rpx; border-radius: 28rpx; background: #fff; }.kicker { color: #74807a; font-size: 22rpx; }.title { margin-top: 14rpx; color: #143f35; font-family: serif; font-size: 46rpx; font-weight: 700; }.summary, .day-copy, .bullet { margin-top: 14rpx; color: #565e5a; font-size: 26rpx; line-height: 1.7; }.fact-row { display: flex; flex-wrap: wrap; gap: 16rpx 28rpx; margin-top: 24rpx; color: #143f35; font-size: 24rpx; }.section-title { margin-bottom: 20rpx; color: #151515; font-size: 32rpx; font-weight: 650; }.departure { display: flex; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid #eceeeb; color: #565e5a; font-size: 25rpx; }.day { padding: 22rpx 0; border-bottom: 1rpx solid #eceeeb; }.day-index { color: #829087; font-size: 20rpx; letter-spacing: 2rpx; }.day-title { margin-top: 8rpx; color: #143f35; font-size: 29rpx; font-weight: 600; }.gallery { white-space: nowrap; }.gallery-image { width: 500rpx; height: 320rpx; margin-right: 18rpx; border-radius: 20rpx; }.notice { background: #e7ece8; }.action-bar { position: fixed; right: 0; bottom: 0; left: 0; z-index: 5; padding: 20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.96); }.consult-button { border-radius: 999rpx; background: #143f35; color: #fff; font-size: 29rpx; font-weight: 600; }.consult-button::after { border: 0; }

