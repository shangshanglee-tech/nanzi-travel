<view class="page with-action">
  <page-nav title="{{product.title || '行程详情'}}" show-back="{{true}}" />
  <view wx:if="{{loading}}" class="loading">正在展开完整行程…</view>
  <empty-state wx:elif="{{error}}" title="暂时无法查看行程" description="{{error}}" bind:retry="loadProduct" />
  <block wx:else>
    <image wx:if="{{product.hero_image}}" class="hero" src="{{product.hero_image}}" mode="aspectFill" />
    <view class="intro">
      <view class="kicker">{{product.destination.name}} · {{product.season}}</view>
      <view class="title">{{product.title}}</view>
      <view class="summary">{{product.summary}}</view>
      <view class="fact-row"><text wx:if="{{durationLabel}}">{{durationLabel}}</text><text wx:if="{{product.departure_city}}">{{product.departure_city}}出发</text></view>
    </view>
    <view wx:if="{{product.highlights.length}}" class="section"><view class="section-title">行程亮点</view><view wx:for="{{product.highlights}}" wx:key="*this" class="bullet">· {{item}}</view></view>
    <view wx:if="{{product.vessels.length}}" class="section"><view class="section-title">可能执行的探险船</view><view class="vessel-list"><view wx:for="{{product.vessels}}" wx:key="slug" class="vessel-card" bindtap="openVessel" data-slug="{{item.slug}}"><image wx:if="{{item.card_image}}" class="vessel-image" src="{{item.card_image}}" mode="aspectFill" /><view><view class="vessel-name">{{item.name}} <text>›</text></view><view class="vessel-copy">{{item.summary}}</view><view class="vessel-fact"><text wx:if="{{item.capacity}}">约 {{item.capacity}} 位宾客</text><text wx:if="{{item.year_built}}">{{item.year_built}} 年</text></view></view></view></view></view>
    <view wx:if="{{product.departures.length}}" class="section"><view class="section-title">选择出发日期</view><view class="section-lead">选中日期后会显示该团期的实际执行船只；最终以旅行顾问确认的信息为准。</view><view wx:for="{{product.departures}}" wx:key="index" class="departure {{selectedDeparture.start_date === item.start_date && selectedDeparture.vessel.slug === item.vessel.slug ? 'departure-selected' : ''}}" bindtap="selectDeparture" data-index="{{index}}"><view><view class="departure-date">{{item.label || item.start_date}}</view><view wx:if="{{item.vessel}}" class="departure-vessel">执行船只：{{item.vessel.name}}</view></view><text class="departure-arrow">{{selectedDeparture.start_date === item.start_date && selectedDeparture.vessel.slug === item.vessel.slug ? '已选择' : '选择'}}</text></view><view wx:if="{{selectedDeparture.vessel}}" class="selected-ship" bindtap="openVessel" data-slug="{{selectedDeparture.vessel.slug}}"><view><view class="selected-ship-label">本团期执行船只</view><view class="selected-ship-name">{{selectedDeparture.vessel.name}} <text>›</text></view><view class="selected-ship-copy">{{selectedDeparture.vessel.summary}}</view></view></view></view>
    <view wx:if="{{product.itinerary_days.length}}" class="section"><view class="section-title">每日行程</view><view wx:for="{{product.itinerary_days}}" wx:key="day_number" class="day"><view class="day-index">DAY {{item.day_number}}<text wx:if="{{item.source_range}}"> · 原行程 {{item.source_range}}</text></view><view class="day-title">{{item.title}}</view><view class="day-copy">{{item.description}}</view></view></view>
    <view wx:if="{{product.images.length}}" class="section"><view class="section-title">旅程影像</view><scroll-view scroll-x class="gallery"><image wx:for="{{product.images}}" wx:key="image" class="gallery-image" src="{{item.image}}" mode="aspectFill" /></scroll-view></view>
    <view wx:if="{{product.included.length}}" class="section"><view class="section-title">服务包含</view><view wx:for="{{product.included}}" wx:key="*this" class="bullet">· {{item}}</view></view>
    <view wx:if="{{product.excluded.length}}" class="section"><view class="section-title">服务不含</view><view wx:for="{{product.excluded}}" wx:key="*this" class="bullet">· {{item}}</view></view>
    <view wx:if="{{product.suitable_for.length}}" class="section"><view class="section-title">适合人群</view><view wx:for="{{product.suitable_for}}" wx:key="*this" class="bullet">· {{item}}</view></view>
    <view wx:if="{{product.notices.length}}" class="section notice"><view class="section-title">重要提醒</view><view wx:for="{{product.notices}}" wx:key="*this" class="bullet">· {{item}}</view></view>
    <view class="action-bar"><button class="consult-button" bindtap="consult">咨询该行程</button></view>
  </block>
</view>
