.page { padding: 26rpx 30rpx 60rpx; }.picker-row { display: flex; flex-wrap: wrap; gap: 14rpx; margin-bottom: 18rpx; }.picker-button { padding: 16rpx 22rpx; border: 1rpx solid #d8ded9; border-radius: 18rpx; background: #fff; color: #3f4843; font-size: 24rpx; }.selected-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 18rpx; }.selected { padding: 10rpx 18rpx; border-radius: 999rpx; background: #dbe6de; color: #143f35; font-size: 22rpx; }.filters { width: 100%; margin-bottom: 26rpx; white-space: nowrap; }.filter-row { display: inline-flex; gap: 16rpx; }.filter { padding: 14rpx 24rpx; border-radius: 999rpx; background: #e7e9e6; color: #58605c; font-size: 24rpx; }.filter.active { background: #143f35; color: #fff; }.loading { padding: 100rpx 0; color: #777e7a; text-align: center; }
