<view class="page">
  <view class="hero">
    <view class="eyebrow">HUMAN SERVICE</view>
    <view class="title">和小楠子聊聊这次旅行</view>
    <view class="lead">关注公众号后发送咨询内容，由旅行顾问为你提供人工服务。</view>
  </view>

  <view class="official-card">
    <view class="label">已关联公众号</view>
    <official-account binderror="handleOfficialAccountError"></official-account>
    <view wx:if="{{componentUnavailable}}" class="component-note">当前入口暂不支持直接展示公众号，请使用下方搜索方式。</view>
  </view>

  <view class="fallback-card">
    <view class="step">01</view>
    <view class="step-content">
      <view class="step-title">在微信中搜索公众号</view>
      <view class="account-name">{{officialAccountName}}</view>
      <view class="step-copy">{{officialAccountGuide}}</view>
      <button class="outline-button" bindtap="copyAccountName">复制公众号名称</button>
    </view>
  </view>
  <view class="fallback-card">
    <view class="step">02</view>
    <view class="step-content">
      <view class="step-title">关注后发送这句话</view>
      <view class="consultation-copy">{{consultationCopy}}</view>
      <button class="primary-button" bindtap="copyConsultation">复制咨询内容</button>
    </view>
  </view>
</view>
