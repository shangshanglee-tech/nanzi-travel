.page { padding: 34rpx 30rpx 70rpx; }.hero { padding: 30rpx 8rpx 38rpx; }.eyebrow { color: #74807a; font-size: 21rpx; letter-spacing: 3rpx; }.title { margin-top: 16rpx; color: #143f35; font-family: serif; font-size: 48rpx; font-weight: 700; line-height: 1.3; }.lead { margin-top: 18rpx; color: #626a66; font-size: 27rpx; line-height: 1.7; }.official-card, .fallback-card { margin-bottom: 22rpx; padding: 30rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 12rpx 34rpx rgba(20,63,53,.06); }.label { margin-bottom: 20rpx; color: #78817d; font-size: 22rpx; }.component-note { margin-top: 18rpx; color: #8a6d41; font-size: 23rpx; line-height: 1.6; }.fallback-card { display: flex; gap: 22rpx; }.step { flex: none; width: 60rpx; height: 60rpx; border-radius: 18rpx; background: #dbe6de; color: #143f35; font-size: 22rpx; font-weight: 700; line-height: 60rpx; text-align: center; }.step-content { flex: 1; min-width: 0; }.step-title { color: #151515; font-size: 29rpx; font-weight: 650; }.account-name { margin-top: 18rpx; color: #143f35; font-size: 32rpx; font-weight: 700; }.step-copy { margin-top: 12rpx; color: #666d69; font-size: 25rpx; line-height: 1.65; }.consultation-copy { margin-top: 18rpx; padding: 22rpx; border-radius: 18rpx; background: #f3f2ee; color: #343a37; font-size: 26rpx; line-height: 1.6; }.outline-button, .primary-button { margin-top: 22rpx; border-radius: 999rpx; font-size: 25rpx; }.outline-button { border: 1rpx solid #143f35; background: transparent; color: #143f35; }.primary-button { background: #143f35; color: #fff; }.outline-button::after, .primary-button::after { border: 0; }

