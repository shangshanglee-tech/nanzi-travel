<view class="nav {{transparent && !collapsed ? 'transparent' : ''}} {{collapsed ? 'collapsed' : ''}}" style="padding-top: {{metrics.topPadding}}px; height: {{metrics.topPadding + metrics.height}}px; padding-right: {{metrics.rightPadding}}px; background-color: {{collapsed ? backgroundColor : 'transparent'}};">
  <view wx:if="{{showBack}}" class="back-button" bindtap="goBack" aria-label="返回">‹</view>
  <view wx:if="{{showTitle}}" class="nav-title">{{title}}</view>
</view>
